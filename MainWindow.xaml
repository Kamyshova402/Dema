<Window x:Class="Dema.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Dema"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Вход в систему" 
                   FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Логин:" FontSize="14" VerticalAlignment="Center"/>
            <TextBox x:Name="txtLogin" Grid.Row="1" Grid.Column="1" Height="32" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль:" FontSize="14" VerticalAlignment="Center"/>
            <PasswordBox x:Name="txtPass" Grid.Row="2" Grid.Column="1" Height="32" FontSize="14" Margin="0,0,0,15"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Капча:" FontSize="14" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock x:Name="lblCaptcha" FontSize="24" FontWeight="Bold" 
                       VerticalAlignment="Center" Width="120" Height="40" Text="0000"
                       Background="LightGray" TextAlignment="Center" Padding="5"/>
                <Button x:Name="btnRefresh" Content="⟳" Width="50" Height="40" Margin="10,0,0,0" FontSize="18"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Введите капчу:" FontSize="14" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="0,0,662,0"/>
            <TextBox x:Name="txtCaptcha" Grid.Row="4" Grid.Column="1" Height="32" FontSize="14" Margin="23,1,5,0"/>

            <Button x:Name="btnLogin" Grid.Row="5" Grid.ColumnSpan="2" Content="ВОЙТИ" 
                Height="45" Margin="0,15,0,0" FontSize="16" FontWeight="Bold"
                Background="#4CAF50" Foreground="White"/>

            <TextBlock x:Name="lblError" Grid.Row="6" Grid.ColumnSpan="2" 
                   Foreground="Red" TextWrapping="Wrap" Margin="0,15,0,0" 
                   HorizontalAlignment="Center" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
